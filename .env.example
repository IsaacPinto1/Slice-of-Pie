# Copy this file to .env and fill in real values.
# The backend loads it automatically (see spring.config.import in application.yml).
# NOTE: for a hosted backend (Render/Railway/Fly/etc), set these as real
# environment variables in that platform's dashboard instead - this .env
# file is only auto-loaded for local runs, and shouldn't be deployed.

# --- Database ---
# Local dev default (matches docker-compose.yml):
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sliceofpie
SPRING_DATASOURCE_USERNAME=dev_user
SPRING_DATASOURCE_PASSWORD=password
#
# Supabase (Project Settings -> Database -> Connection string -> JDBC).
# Use the "Session pooler" connection for app servers - it's IPv4-reachable
# and handles connection pooling for you:
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
# SPRING_DATASOURCE_USERNAME=postgres.<your-project-ref>
# SPRING_DATASOURCE_PASSWORD=<your-supabase-db-password>

# --- Auth ---
# Any long, random string works locally. Use a different, real secret in prod.
JWT_SECRET=dev-secret-key-super-long-for-sure-12345679

# --- External APIs ---
# Get a free key at https://finnhub.io/register
FINNHUB_API_KEY=

# SnapTrade Personal key (broker/positions feature) - leave blank to run
# without this feature. Comma-separated list of app usernames allowed to
# use it - see BrokerAccessGuard.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_ALLOWED_USERNAMES=

# --- CORS ---
# Comma-separated list of origins allowed to call this API.
# Local dev default is fine as-is; in prod, set this to your Vercel URL(s),
# e.g. https://slice-of-pie.vercel.app,https://slice-of-pie-git-main.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173
