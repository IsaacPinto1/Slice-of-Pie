# Copy this file to .env and fill in real values.
# The backend loads it automatically (see spring.config.import in application.yml).

# --- Database (must match docker-compose.yml for local dev) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sliceofpie
SPRING_DATASOURCE_USERNAME=dev_user
SPRING_DATASOURCE_PASSWORD=password

# --- Auth ---
# Any long, random string works locally. Use a real secret in prod.
JWT_SECRET=dev-secret-key-super-long-for-sure-12345679

# --- External APIs ---
# Get a free key at https://finnhub.io/register
FINNHUB_API_KEY=
