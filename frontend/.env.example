# Copy this file to .env for local dev.
VITE_API_URL=http://localhost:8080

# For a Vercel deploy, don't put the prod value here - set VITE_API_URL as
# a real Environment Variable in the Vercel project settings instead,
# pointing at wherever the backend is hosted, e.g.:
# VITE_API_URL=https://sliceofpie-api.onrender.com
